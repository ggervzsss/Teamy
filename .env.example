# Local Database & Redis (Docker Compose)
MYSQL_DATABASE=teamy
MYSQL_USER=teamy
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307
REDIS_PORT=6379

# Backend
DATABASE_URL=mysql+aiomysql://teamy:teamy@db:3306/teamy?charset=utf8mb4
DATABASE_SSL=false
DATABASE_SSL_CA=/etc/ssl/certs/ca-certificates.crt
REDIS_URL=
SECRET_KEY=

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo (Email Notifications)
BREVO_API_KEY=
BREVO_FROM_EMAIL="Teamy <teamy.app.official@gmail.com>"